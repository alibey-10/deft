# Production Convex endpoints (deployment adept-meerkat-414). Vite loads this on top of
# .env for `vp build`, so Cloudflare Workers Builds and `bun run deploy` both ship
# against prod. VITE_* values are inlined into the bundle at build time; they are
# public, not secrets.
VITE_CONVEX_URL=https://adept-meerkat-414.eu-west-1.convex.cloud
VITE_CONVEX_SITE_URL=https://adept-meerkat-414.eu-west-1.convex.site
