# Public Convex endpoints, committed so every worktree and clone works out of the box.
# These are exposed to the browser and are not secrets. Put secrets and per-machine
# overrides (e.g. CONVEX_DEPLOYMENT, deploy keys) in .env.local, which is git-ignored.
VITE_CONVEX_URL=https://exciting-cuttlefish-67.eu-west-1.convex.cloud
VITE_CONVEX_SITE_URL=https://exciting-cuttlefish-67.eu-west-1.convex.site
